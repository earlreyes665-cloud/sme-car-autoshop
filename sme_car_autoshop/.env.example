# TiDB Cloud Starter
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_new_tidb_password
TIDB_DATABASE=sme_car_autoshop
# For local development, point to the downloaded CA file:
TIDB_CA_PATH=certs/ca.pem
# For Render, Base64-encode the downloaded CA certificate and set this instead:
# TIDB_CA_CERT_BASE64=your_base64_encoded_ca_certificate

SECRET_KEY=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
ADMIN_FULL_NAME=SME Car Autoshop Administrator
ADMIN_EMAIL=admin@example.com
FLASK_DEBUG=0
